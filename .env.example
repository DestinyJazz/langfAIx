# Settings of the standalone stack (docker-compose.yml). Copy to .env and edit.
# .env holds secrets: it is in .gitignore and must never be committed.

# Database password. Letters and digits only (it is used inside a URL).
POSTGRES_PASSWORD=

# LiteLLM admin key. Must start with sk-. Use a long random string.
LITELLM_MASTER_KEY=

# Encrypts the API keys LiteLLM stores. Set once; it cannot be changed later.
LITELLM_SALT_KEY=

# The model provider's API key. Only LiteLLM sees it. Leave empty if you only use a
# self-hosted model (vLLM, Ollama) added in the LiteLLM admin UI.
OPENAI_API_KEY=

# The initial glossary admins, comma separated: the aliases (key names) of LiteLLM virtual
# keys. Not secrets. Empty means everyone is read-only until this is set.
GLOSSARY_ADMINS=

# What the glossary is about. A row is a standard English term, optionally with the term of a
# source language it was translated from, plus wrong forms. The defaults are made for
# Chinese to English documentation; leave these empty to keep them.
#   GLOSSARY_SOURCE_LANGUAGE  name shown on the admin page and in the AI prompt, e.g. Russian
#   GLOSSARY_SOURCE_SCRIPT    how that language is recognised inside English text: han (default),
#                             cyrillic, hangul, kana, arabic, hebrew, thai, devanagari, greek,
#                             or none for an English-only glossary (standard terms and wrong forms)
#   GLOSSARY_CATEGORIES       the default categories, comma separated
GLOSSARY_SOURCE_LANGUAGE=
GLOSSARY_SOURCE_SCRIPT=
GLOSSARY_CATEGORIES=

# Where Caddy serves langfAIx and the LiteLLM admin UI.
#   plain HTTP on this machine (for trying it out):
LANGFAIX_SITE=http://:80
LITELLM_SITE=http://:4000
LITELLM_PUBLIC_URL=http://localhost:4000
#   real host names (Caddy then obtains certificates and serves HTTPS):
# LANGFAIX_SITE=langfaix.example.com
# LITELLM_SITE=langfaix-litellm.example.com
# LITELLM_PUBLIC_URL=https://langfaix-litellm.example.com

# The model alias the backend asks LiteLLM for. Add a model with exactly this
# Public Model Name in the LiteLLM admin UI.
AI_MODEL=langfAIx-model-1

# The AI prompt. The rules (minimal edits, never change product names, the reply format)
# are in backend/app/prompt.py and are not configurable: the code that reads the model's
# reply depends on them. You can change what the text is about and add style preferences.
# Empty keeps the built-in default, "technical product documentation".
AI_PROMPT_DOMAIN=
# Example: AI_PROMPT_EXTRA=Use British spelling. Prefer short sentences.
AI_PROMPT_EXTRA=
